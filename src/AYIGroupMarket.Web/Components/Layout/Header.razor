@inject Microsoft.Extensions.Localization.IStringLocalizer<AYIGroupMarket.Web.Resources.SharedResource> Localizer
@inject AYIGroupMarket.Web.Services.CartSessionProvider CartSession
@inject ISender Sender
@inject AuthenticationStateProvider AuthStateProvider
@using AYIGroupMarket.Application.Features.Notifications.GetMyNotifications
@using AYIGroupMarket.Application.Features.Notifications.MarkNotificationRead
@using System.Security.Claims
@using AYIGroupMarket.Application.Features.Cart.GetCart
@inject AYIGroupMarket.Web.Services.CartNotifier CartNotifier
@implements IDisposable

<header class="site-header sticky-top bg-white border-bottom">
    <div class="container">
        <div class="d-flex align-items-center gap-4 py-2">

            <a href="/" class="d-flex align-items-center gap-2 text-decoration-none flex-shrink-0">
                <span class="logo-mark">A</span>
                <span class="fw-bold text-dark lh-1">
                    AYI GROUP
                    <small class="d-block text-uppercase" style="font-size:.55rem; letter-spacing:.1em; color:var(--ayi-orange-dark);">Market</small>
                </span>
            </a>

            <nav class="d-none d-lg-flex align-items-center gap-4 flex-grow-1">
                <NavLink class="nav-link-custom" href="" Match="NavLinkMatch.All">@Localizer["NavHome"]</NavLink>
                <NavLink class="nav-link-custom" href="boutique">@Localizer["NavShop"]</NavLink>
                <NavLink class="nav-link-custom" href="grossistes">@Localizer["NavWholesale"]</NavLink>
                <NavLink class="nav-link-custom" href="apropos">@Localizer["NavAbout"]</NavLink>
                <NavLink class="nav-link-custom" href="contact">@Localizer["NavContact"]</NavLink>
            </nav>

            <div class="d-flex align-items-center gap-1 ms-auto">
                <button class="icon-btn" aria-label="@Localizer["AriaSearch"]">
                    <i class="bi bi-search"></i>
                </button>
                <AuthorizeView>
                    <Authorized>
                        <div class="dropdown">
                            <button class="icon-btn position-relative" data-bs-toggle="dropdown" aria-label="Notifications">
                                <i class="bi bi-bell"></i>
                                @if (unreadCount > 0)
                                {
                                    <span class="cart-badge">@unreadCount</span>
                                }
                            </button>
                            <div class="dropdown-menu dropdown-menu-end p-2" style="width: 320px; max-height: 400px; overflow-y:auto;">
                                @if (notifications is null || !notifications.Any())
                                {
                                    <p class="text-secondary small px-2 mb-0">No notifications</p>
                                }
                                else
                                {
                                    @foreach (var n in notifications)
                                    {
                                        <a href="@(n.LinkUrl ?? "#")" class="dropdown-item @(n.IsRead ? "" : "fw-bold")"
                                        @onclick="() => MarkRead(n.Id)">
                                            <div class="small">@n.Title</div>
                                            <div class="text-secondary" style="font-size:.75rem;">@n.Message</div>
                                        </a>
                                    }
                                }
                            </div>
                        </div>
                        <a href="/mon-compte" class="icon-btn" aria-label="Account"><i class="bi bi-person-fill"></i></a>
                        <form method="post" action="/account/logout">
                            <button type="submit" class="icon-btn" aria-label="Logout"><i class="bi bi-box-arrow-right"></i></button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/account/login" class="icon-btn" aria-label="Login"><i class="bi bi-person"></i></a>
                    </NotAuthorized>
                </AuthorizeView>
                <a href="/panier" class="icon-btn position-relative" aria-label="@Localizer["AriaCart"]">
                    <i class="bi bi-cart3"></i>
                    @if (itemCount > 0)
                    {
                        <span class="cart-badge">@itemCount</span>
                    }
                </a>
                <LanguageToggle />
                <button class="icon-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNav" aria-label="Menu">
                    <i class="bi bi-list"></i>
                </button>
            </div>
        </div>
    </div>
    <div class="offcanvas offcanvas-end" tabindex="-1" id="mobileNav">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">Menu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column gap-3">
        <NavLink class="nav-link-custom" href="" Match="NavLinkMatch.All">@Localizer["NavHome"]</NavLink>
        <NavLink class="nav-link-custom" href="boutique">@Localizer["NavShop"]</NavLink>
        <NavLink class="nav-link-custom" href="grossistes">@Localizer["NavWholesale"]</NavLink>
        <NavLink class="nav-link-custom" href="apropos">@Localizer["NavAbout"]</NavLink>
        <NavLink class="nav-link-custom" href="contact">@Localizer["NavContact"]</NavLink>
    </div>
</div>
</header>

@code {
    private int itemCount = 0;
    private List<AYIGroupMarket.Application.Features.Notifications.GetMyNotifications.NotificationDto>? notifications;
    private int unreadCount => notifications?.Count(n => !n.IsRead) ?? 0;

    // Call this from OnAfterRenderAsync(firstRender), alongside the existing cart count refresh:
    private async Task LoadNotifications()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true) return;

        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (userId is not null)
            notifications = await Sender.Send(new GetMyNotificationsQuery(userId));
    }

    private async Task MarkRead(Guid notificationId)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (userId is null) return;

        await Sender.Send(new MarkNotificationReadCommand(notificationId, userId));
        await LoadNotifications();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CartNotifier.OnCartChanged += HandleCartChanged;
            await RefreshCartCount();
            await LoadNotifications();
            StateHasChanged();
        }
    }

    private async Task HandleCartChanged()
    {
        await RefreshCartCount();
        await LoadNotifications();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CartNotifier.OnCartChanged -= HandleCartChanged;
    }

    @* protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshCartCount();
            StateHasChanged();
        }
    } *@

    public async Task RefreshCartCount()
    {
        var ownerKey = await CartSession.GetOwnerKeyAsync();
        var cart = await Sender.Send(new GetCartQuery(ownerKey));
        itemCount = cart.ItemCount;
    }
}