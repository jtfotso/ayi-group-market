@inject Microsoft.Extensions.Localization.IStringLocalizer<AYIGroupMarket.Web.Resources.SharedResource> Localizer
@inject AYIGroupMarket.Web.Services.CartSessionProvider CartSession
@inject ISender Sender
@using AYIGroupMarket.Application.Features.Cart.GetCart
@inject AYIGroupMarket.Web.Services.CartNotifier CartNotifier
@implements IDisposable

<header class="site-header sticky-top bg-white border-bottom">
    <div class="container">
        <div class="d-flex align-items-center gap-4 py-2">

            <a href="/" class="d-flex align-items-center gap-2 text-decoration-none flex-shrink-0">
                <span class="logo-mark">A</span>
                <span class="fw-bold text-dark lh-1">
                    AYI GROUP
                    <small class="d-block text-uppercase" style="font-size:.55rem; letter-spacing:.1em; color:var(--ayi-orange-dark);">Market</small>
                </span>
            </a>

            <nav class="d-none d-lg-flex align-items-center gap-4 flex-grow-1">
                <NavLink class="nav-link-custom" href="" Match="NavLinkMatch.All">@Localizer["NavHome"]</NavLink>
                <NavLink class="nav-link-custom" href="boutique">@Localizer["NavShop"]</NavLink>
                <NavLink class="nav-link-custom" href="grossistes">@Localizer["NavWholesale"]</NavLink>
                <NavLink class="nav-link-custom" href="apropos">@Localizer["NavAbout"]</NavLink>
                <NavLink class="nav-link-custom" href="contact">@Localizer["NavContact"]</NavLink>
            </nav>

            <div class="d-flex align-items-center gap-1 ms-auto">
                <button class="icon-btn" aria-label="@Localizer["AriaSearch"]">
                    <i class="bi bi-search"></i>
                </button>
                <button class="icon-btn" aria-label="@Localizer["AriaAccount"]">
                    <i class="bi bi-person"></i>
                </button>
                <a href="/panier" class="icon-btn position-relative" aria-label="@Localizer["AriaCart"]">
                    <i class="bi bi-cart3"></i>
                    @if (itemCount > 0)
                    {
                        <span class="cart-badge">@itemCount</span>
                    }
                </a>
                <LanguageToggle />
                <button class="icon-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNav" aria-label="Menu">
                    <i class="bi bi-list"></i>
                </button>
            </div>
        </div>
    </div>
    <div class="offcanvas offcanvas-end" tabindex="-1" id="mobileNav">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">Menu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column gap-3">
        <NavLink class="nav-link-custom" href="" Match="NavLinkMatch.All">@Localizer["NavHome"]</NavLink>
        <NavLink class="nav-link-custom" href="boutique">@Localizer["NavShop"]</NavLink>
        <NavLink class="nav-link-custom" href="grossistes">@Localizer["NavWholesale"]</NavLink>
        <NavLink class="nav-link-custom" href="apropos">@Localizer["NavAbout"]</NavLink>
        <NavLink class="nav-link-custom" href="contact">@Localizer["NavContact"]</NavLink>
    </div>
</div>
</header>

@code {
    private int itemCount = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CartNotifier.OnCartChanged += HandleCartChanged;
            await RefreshCartCount();
            StateHasChanged();
        }
    }

    private async Task HandleCartChanged()
    {
        await RefreshCartCount();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CartNotifier.OnCartChanged -= HandleCartChanged;
    }

    @* protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshCartCount();
            StateHasChanged();
        }
    } *@

    public async Task RefreshCartCount()
    {
        var ownerKey = await CartSession.GetOwnerKeyAsync();
        var cart = await Sender.Send(new GetCartQuery(ownerKey));
        itemCount = cart.ItemCount;
    }
}