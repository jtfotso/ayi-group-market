@page "/"
@inject Microsoft.Extensions.Localization.IStringLocalizer<AYIGroupMarket.Web.Resources.SharedResource> Localizer

<PageTitle>AYI GROUP MARKET</PageTitle>

<!-- ============ HERO ============ -->
<section class="bg-ayi-soft border-bottom py-5">
    <div class="container">
        <div class="row align-items-center gy-4">
            <div class="col-lg-6">
                <span class="text-ayi-eyebrow">@Localizer["HeroEyebrow"]</span>
                <h1 class="display-5 fw-bold mt-2 mb-3">@Localizer["HeroH1"]</h1>
                <p class="text-secondary mb-4" style="max-width: 480px;">@Localizer["HeroLede"]</p>
                <div class="d-flex gap-3 flex-wrap mb-4">
                    <a href="/boutique" class="btn btn-success btn-lg">@Localizer["CtaBuyNow"]</a>
                    <a href="#" class="btn btn-outline-success btn-lg">@Localizer["CtaWhatsapp"]</a>
                </div>
                <div class="d-flex gap-4 flex-wrap small text-secondary fw-semibold">
                    <span>✓ @Localizer["TrustStrip1"]</span>
                    <span>✓ @Localizer["TrustStrip2"]</span>
                    <span>✓ @Localizer["TrustStrip3"]</span>
                </div>
            </div>
            <div class="col-lg-6 text-center">
    <div class="hero-visual">
        <div class="stamp"><span>100%<br>@Localizer["StampNatural"]<br>@Localizer["StampQuality"]</span></div>
        <div class="crate">
            <div class="bottle-row">
                <div class="bottle b1"><div class="cap"></div><div class="label">@Localizer["Bottle1"]</div></div>
                <div class="bottle b2"><div class="cap"></div><div class="label">@Localizer["Bottle2"]</div></div>
                <div class="bottle b3"><div class="cap"></div><div class="label">@Localizer["Bottle3"]</div></div>
                <div class="bottle b4"><div class="cap"></div><div class="label">@Localizer["Bottle4"]</div></div>
            </div>
        </div>
        <div class="hero-tag"><span class="dot"></span> @Localizer["HeroTag"]</div>
    </div>
</div>
        </div>
    </div>
</section>

<!-- ============ CATEGORIES ============ -->
<section class="py-5">
    <div class="container">
        <span class="text-ayi-eyebrow">@Localizer["CatalogEyebrow"]</span>
        <h2 class="fw-bold mt-2 mb-2">@Localizer["CatalogH2"]</h2>
        <p class="text-secondary mb-4" style="max-width: 600px;">@Localizer["CatalogP"]</p>

        <div class="row g-3">
            <div class="col-6 col-md-4 col-lg">
                <div class="card h-100 border-0 bg-ayi-soft rounded-4 p-2">
                    <div class="card-body">
                        <div class="fs-2 mb-2">🌿</div>
                        <h3 class="h6 fw-bold">@Localizer["CatFood"]</h3>
                        <ul class="list-unstyled small text-secondary">
                            <li>Jus FRUILEG</li>
                            <li>Chips</li>
                            <li>Chia BIO</li>
                        </ul>
                        <a href="#" class="small fw-bold text-success text-decoration-none">@Localizer["CatLink"]</a>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg">
                <div class="card h-100 border-0 bg-ayi-soft rounded-4 p-2">
                    <div class="card-body">
                        <div class="fs-2 mb-2">🏡</div>
                        <h3 class="h6 fw-bold">@Localizer["CatHome"]</h3>
                        <ul class="list-unstyled small text-secondary">
                            <li>AER</li>
                            <li>ABRO Organic</li>
                        </ul>
                        <a href="#" class="small fw-bold text-success text-decoration-none">@Localizer["CatLink"]</a>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg">
                <div class="card h-100 border-0 bg-ayi-soft rounded-4 p-2">
                    <div class="card-body">
                        <div class="fs-2 mb-2">🚗</div>
                        <h3 class="h6 fw-bold">@Localizer["CatAuto"]</h3>
                        <ul class="list-unstyled small text-secondary">
                            <li>@Localizer["AutoLi1"]</li>
                            <li>@Localizer["AutoLi2"]</li>
                        </ul>
                        <a href="#" class="small fw-bold text-success text-decoration-none">@Localizer["CatLink"]</a>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg">
                <div class="card h-100 border-0 rounded-4 p-2 position-relative overflow-hidden" style="background:#fbfbfb;">
                    <span class="soon-badge-ribbon">@Localizer["SoonBadge"]</span>
                    <div class="card-body">
                        <div class="fs-2 mb-2">🔌</div>
                        <h3 class="h6 fw-bold text-secondary">@Localizer["CatAppliances"]</h3>
                        <p class="small text-secondary mb-0">@Localizer["ComingSoon"]</p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg">
                <div class="card h-100 border-0 rounded-4 p-2 position-relative overflow-hidden" style="background:#fbfbfb;">
                    <span class="soon-badge-ribbon">@Localizer["SoonBadge"]</span>
                    <div class="card-body">
                        <div class="fs-2 mb-2">🚿</div>
                        <h3 class="h6 fw-bold text-secondary">@Localizer["CatBath"]</h3>
                        <p class="small text-secondary mb-0">@Localizer["ComingSoon"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============ TRUST SIGNALS ============ -->
<section class="bg-ayi-deep py-5">
    <div class="container">
        <span class="text-ayi-eyebrow" style="color:#a7d9bf;">@Localizer["TrustEyebrow"]</span>
        <h2 class="fw-bold mt-2 mb-2 text-white">@Localizer["TrustH2"]</h2>
        <p class="mb-4" style="color:#cfe8db; max-width:600px;">@Localizer["TrustP"]</p>

        <div class="row g-3">
            @{
                var trustItems = new[] { "Trust1", "Trust2", "Trust3", "Trust4", "Trust5" };
            }
            @for (int i = 0; i < trustItems.Length; i++)
            {
                var key = trustItems[i];
                <div class="col-6 col-md-4 col-lg">
                    <div class="p-3 rounded-4 h-100" style="background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.14);">
                        <span class="d-block small fw-bold mb-2" style="color:var(--ayi-orange);">0@(i + 1)</span>
                        <p class="mb-0 fw-semibold text-white small">@Localizer[key]</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ============ WHOLESALE STRIP ============ -->
<section class="bg-ayi-soft border-top border-bottom py-5">
    <div class="container d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <span class="text-ayi-eyebrow">@Localizer["WsEyebrow"]</span>
            <h3 class="fw-bold mt-2 mb-1">@Localizer["WsH3"]</h3>
            <p class="text-secondary mb-0" style="max-width:460px;">@Localizer["WsP"]</p>
        </div>
        <a href="#" class="btn btn-outline-success">@Localizer["WsBtn"]</a>
    </div>
</section>