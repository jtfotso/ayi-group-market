@page "/grossistes/devis"
@attribute [Authorize(Policy = "WholesaleCustomer")]
@inject ISender Sender
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@using AYIGroupMarket.Application.Features.Products.GetProducts
@using AYIGroupMarket.Application.Features.Wholesale.SubmitQuoteRequest
@using AYIGroupMarket.Application.DTOs
@using System.Globalization
@using System.Security.Claims

<PageTitle>@(IsFr ? "Demande de devis" : "Quote request") — AYI GROUP MARKET</PageTitle>

<div class="container py-5">
    <h1 class="fw-bold mb-4">@(IsFr ? "Demande de devis" : "Request a quote")</h1>

    <div class="row g-4">
        <div class="col-lg-7">
            <h2 class="h5 fw-bold mb-3">@(IsFr ? "Produits" : "Products")</h2>

            @if (products is not null)
            {
                @foreach (var p in products.Items)
                {
                    <div class="d-flex align-items-center gap-3 border-bottom py-2">
                        <div class="flex-grow-1">@(IsFr ? p.Name : p.NameEn)</div>
                        <input type="number" min="0" class="form-control" style="width:90px;"
                               @onchange="@(e => UpdateQuantity(p.Id, e.Value))" />
                    </div>
                }
            }

            <h2 class="h5 fw-bold mt-4 mb-3">@(IsFr ? "Livraison" : "Delivery")</h2>
            <input class="form-control mb-3" placeholder="@(IsFr ? "Lieu de livraison" : "Delivery location")" @bind="deliveryLocation" />
            <textarea class="form-control mb-3" rows="3" placeholder="@(IsFr ? "Message (optionnel)" : "Message (optional)")" @bind="message"></textarea>

            @if (errorMessage is not null)
            {
                <div class="alert alert-danger">@errorMessage</div>
            }
            @if (successMessage is not null)
            {
                <div class="alert alert-success">@successMessage</div>
            }

            <button class="btn btn-success" @onclick="Submit" disabled="@isSubmitting">
                @(isSubmitting ? (IsFr ? "Envoi..." : "Submitting...") : (IsFr ? "Envoyer la demande" : "Send request"))
            </button>
        </div>
    </div>
</div>

@code {
    private PagedResult<AYIGroupMarket.Application.DTOs.ProductListItemDto>? products;
    private Dictionary<Guid, int> quantities = new();
    private string deliveryLocation = "";
    private string message = "";
    private bool isSubmitting = false;
    private string? errorMessage;
    private string? successMessage;

    private bool IsFr => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fr";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            products = await Sender.Send(new GetProductsQuery(PageSize: 100));
            StateHasChanged();
        }
    }

    private void UpdateQuantity(Guid productId, object? value)
    {
        if (value is string s && int.TryParse(s, out var qty))
            quantities[productId] = qty;
    }

    private async Task Submit()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var items = quantities.Where(kv => kv.Value > 0)
                .Select(kv => new QuoteRequestItemInput(kv.Key, null, kv.Value))
                .ToList();

            if (items.Count == 0)
            {
                errorMessage = IsFr ? "Veuillez indiquer au moins un produit." : "Please select at least one product.";
                return;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
                ?? throw new InvalidOperationException("Not authenticated");

            await Sender.Send(new SubmitQuoteRequestCommand(userId, deliveryLocation, message, items));

            successMessage = IsFr ? "Votre demande de devis a été envoyée !" : "Your quote request has been sent!";
            quantities.Clear();
        }
        catch (Exception)
        {
            errorMessage = IsFr ? "Une erreur est survenue." : "Something went wrong.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}