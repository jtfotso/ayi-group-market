@page "/mon-compte/commandes"
@layout AYIGroupMarket.Web.Components.Layout.AccountLayout
@attribute [Authorize]
@inject ISender Sender
@inject AYIGroupMarket.Web.Services.CartSessionProvider CartSession
@using AYIGroupMarket.Application.Features.Orders.ConfirmOrderReceipt
@inject ISender Sender
@inject AuthenticationStateProvider AuthStateProvider
@using AYIGroupMarket.Application.Features.Orders.GetMyOrders
@using System.Globalization
@using System.Security.Claims

<h2 class="h4 fw-bold mb-3">@(IsFr ? "Mes commandes" : "My orders")</h2>

@if (orders is null)
{
    <p class="text-secondary">@(IsFr ? "Chargement..." : "Loading...")</p>
}
else if (!orders.Any())
{
    <p class="text-secondary">@(IsFr ? "Vous n'avez pas encore de commande." : "You don't have any orders yet.")</p>
    <a href="/boutique" class="btn btn-success">@(IsFr ? "Aller à la boutique" : "Go to shop")</a>
    
}
else
{
    @foreach (var order in orders)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <strong>@order.OrderNumber</strong>
                    <span class="badge bg-secondary">@order.Status</span>
                </div>
                @foreach (var item in order.Items)
                {
                    <div class="d-flex justify-content-between small py-1">
                        <span>@(item.Quantity)x @(IsFr ? item.ProductName : item.ProductNameEn)</span>
                        <span>@item.LineTotal.ToString("C")</span>
                    </div>
                }
                <div class="d-flex justify-content-between fw-bold mt-2 pt-2 border-top">
                    <span>Total</span>
                    <span>@order.Total.ToString("C")</span>
                </div>

                @if (order.Status == "Shipped" || order.Status == "ReadyForDelivery")
                {
                    <button class="btn btn-success btn-sm mt-2" @onclick="() => ConfirmReceipt(order.Id)">
                        @(IsFr ? "Confirmer la réception" : "Confirm receipt")
                    </button>
                }
                @if (order.Status == "Delivered")
                {
                    <p class="small text-success mt-2 mb-0">
                        <i class="bi bi-check-circle-fill"></i> @(IsFr ? "Réception confirmée" : "Receipt confirmed")
                    </p>
                }
                <a href="/facture/@order.OrderNumber" class="btn btn-outline-success btn-sm mt-2" target="_blank">
                    <i class="bi bi-file-earmark-pdf"></i> @(IsFr ? "Télécharger la facture" : "Download invoice")
                </a>
            </div>
        </div>
    }
}

@code {
    private List<AYIGroupMarket.Application.DTOs.OrderDto>? orders;
    private bool IsFr => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fr";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (userId is not null)
                orders = await Sender.Send(new GetMyOrdersQuery($"user:{userId}"));

            StateHasChanged();
        }
    }

    private async Task ConfirmReceipt(Guid orderId)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (userId is null) return;

        try
        {
            await Sender.Send(new ConfirmOrderReceiptCommand(orderId, $"user:{userId}"));
            orders = await Sender.Send(new GetMyOrdersQuery($"user:{userId}"));
        }
        catch (Exception)
        {
            // could surface an error message here if desired; keeping silent-fail simple for now
        }
    }
}