@page "/commande/payunit-return"
@inject ISender Sender
@using AYIGroupMarket.Application.Features.Payments.GetPaymentReferenceByOrderNumber
@inject NavigationManager Nav
@using AYIGroupMarket.Application.Features.Payments.VerifyPayment

<div class="container py-5 text-center">
    @if (isProcessing)
    {
        <p>Vérification du paiement...</p>
    }
    else if (errorMessage is not null)
    {
        <div class="alert alert-danger">@errorMessage</div>
        <a href="/panier" class="btn btn-outline-success">Retour au panier</a>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "orderNumber")] public string? OrderNumber { get; set; }
    [SupplyParameterFromQuery(Name = "transaction_id")] public string? TransactionId { get; set; }

    private bool isProcessing = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(OrderNumber) || string.IsNullOrEmpty(TransactionId))
        {
            errorMessage = "Informations de commande manquantes.";
            isProcessing = false;
            return;
        }

        try
        {
           string referenceToVerify;

            if (!string.IsNullOrEmpty(TransactionId))
            {
                referenceToVerify = TransactionId;
            }
            else
            {
                // PayUnit didn't append transaction_id this time — fall back to looking up
                // the Payment record via the order number instead
                var lookupResult = await Sender.Send(new GetPaymentReferenceByOrderNumberQuery(OrderNumber));
                if (lookupResult is null)
                {
                    errorMessage = "Informations de commande manquantes.";
                    isProcessing = false;
                    return;
                }
                referenceToVerify = lookupResult;
            }

            var verified = await Sender.Send(new VerifyPaymentCommand(referenceToVerify));

            if (verified)
            {
                Nav.NavigateTo($"/commande/confirmation/{OrderNumber}");
            }
            else
            {
                errorMessage = "Le paiement n'a pas pu être confirmé. Il est peut-être encore en attente — veuillez réessayer dans quelques instants ou contacter le support.";
                isProcessing = false;
            }
        }
        catch (Exception )
        {
            @* var innerMessage = ex.InnerException?.Message ?? "no inner exception";
            errorMessage = $"DEBUG: {ex.GetType().Name}: {ex.Message} | INNER: {innerMessage}";
            isProcessing = false; *@
            Nav.NavigateTo($"/commande/confirmation/{OrderNumber}"); // temporarily disabled to see the real error
        }
        
    }
}