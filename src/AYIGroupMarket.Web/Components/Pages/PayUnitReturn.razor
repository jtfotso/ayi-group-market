@page "/commande/payunit-return"
@inject ISender Sender
@inject NavigationManager Nav
@using AYIGroupMarket.Application.Features.Payments.VerifyPayment

<div class="container py-5 text-center">
    @if (isProcessing)
    {
        <p>Vérification du paiement...</p>
    }
    else if (errorMessage is not null)
    {
        <div class="alert alert-danger">@errorMessage</div>
        <a href="/panier" class="btn btn-outline-success">Retour au panier</a>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "orderNumber")] public string? OrderNumber { get; set; }
    [SupplyParameterFromQuery(Name = "transaction_id")] public string? TransactionId { get; set; }

    private bool isProcessing = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(OrderNumber) || string.IsNullOrEmpty(TransactionId))
        {
            errorMessage = "Informations de commande manquantes.";
            isProcessing = false;
            return;
        }

        try
        {
            // TransactionId is PayUnit's own unique transaction reference (from InitiatePaymentAsync),
            // not the order number — needed to correctly look up the Payment record.
            var verified = await Sender.Send(new VerifyPaymentCommand(TransactionId));

            if (verified)
            {
                Nav.NavigateTo($"/commande/confirmation/{OrderNumber}");
            }
            else
            {
                errorMessage = "Le paiement n'a pas pu être confirmé. Il est peut-être encore en attente — veuillez réessayer dans quelques instants ou contacter le support.";
                isProcessing = false;
            }
        }
        catch (Exception)
        {
            // If verification already succeeded on an earlier load, just send them to confirmation directly
            // rather than showing a scary error for what's likely just a duplicate/idempotency edge case
            Nav.NavigateTo($"/commande/confirmation/{OrderNumber}");
        }
        
    }
}