@inject NavigationManager Nav

<div class="lang-toggle">
    <a class="lang-btn @(currentCulture == "fr" ? "is-active" : "")"
       href="@BuildCultureUrl("fr")">FR</a>
    <a class="lang-btn @(currentCulture == "en" ? "is-active" : "")"
       href="@BuildCultureUrl("en")">EN</a>
</div>

@code {
    private string currentCulture => System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private string BuildCultureUrl(string culture)
    {
        var returnUrl = Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri));
        return $"/culture/set?culture={culture}&redirectUri=/{returnUrl}";
    }
}