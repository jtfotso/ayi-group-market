@inject NavigationManager Nav

<div class="lang-toggle">
    <form method="get" action="/culture/set" style="display:inline;">
        <input type="hidden" name="culture" value="fr" />
        <button type="submit" class="lang-btn @(currentCulture == "fr" ? "is-active" : "")">FR</button>
    </form>
    <form method="get" action="/culture/set" style="display:inline;">
        <input type="hidden" name="culture" value="en" />
        <button type="submit" class="lang-btn @(currentCulture == "en" ? "is-active" : "")">EN</button>
    </form>
</div>

@code {
    private string currentCulture => System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}