@page "/customers"
@attribute [Authorize(Policy = "RequireAdmin")]
@inject ISender Sender
@using AYIGroupMarket.Application.Features.Admin.GetCustomers
@using AYIGroupMarket.Application.Features.Admin.GetCustomerDetail
@using AYIGroupMarket.Application.Features.Admin.ManageUserRoles
@using AYIGroupMarket.Application.Features.Admin.GetUserRoles

<PageTitle>Admin — Customers</PageTitle>

<div class="container py-4">
    <h1>Customers</h1>

    <input class="form-control mb-3" style="max-width:400px;" placeholder="Search by name or email"
           @bind="searchTerm" @bind:event="oninput" @onkeyup="OnSearch" />

    <table class="table">
        <thead>
            <tr><th>Name</th><th>Email</th><th>Joined</th><th>Orders</th><th>Total Spent</th><th>Wholesale</th><th></th></tr>
        </thead>
        <tbody>
            @if (customers is not null)
            {
                @foreach (var c in customers)
                {
                    <tr>
                        <td>@c.FirstName @c.LastName</td>
                        <td>@c.Email</td>
                        <td>@c.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>@c.OrderCount</td>
                        <td>@AYIGroupMarket.Admin.Services.CurrencyFormatter.Format(c.TotalSpent)</td>
                        <td>
                            @if (c.IsWholesale)
                            {
                                <span class="badge @WholesaleBadgeClass(c.WholesaleStatus)">@c.WholesaleStatus</span>
                            }
                            else
                            {
                                <span class="text-secondary">-</span>
                            }
                        </td>
                        <td><button class="btn btn-sm btn-outline-primary" @onclick="() => ViewDetail(c.Id)">View</button></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (selectedCustomer is not null)
{
    <div class="modal d-block" style="background:rgba(0,0,0,.5);" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@selectedCustomer.FirstName @selectedCustomer.LastName</h5>
                    <button class="btn-close" @onclick="() => selectedCustomer = null"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Email:</strong> @selectedCustomer.Email</p>
                    <p><strong>Joined:</strong> @selectedCustomer.CreatedAt.ToString("dd/MM/yyyy")</p>
                    @if (selectedCustomer.WholesaleStatus is not null)
                    {
                        <p><strong>Wholesale:</strong> @selectedCustomer.WholesaleCompanyName (@selectedCustomer.WholesaleStatus)</p>
                    }

                    <h6 class="mt-3">Roles</h6>
                    @if (allRoles is not null && userRoles is not null)
                    {
                        @foreach (var role in allRoles)
                        {
                            var isChecked = userRoles.Contains(role);
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" checked="@isChecked"
                                    @onchange="@(e => ToggleRole(selectedCustomer!.Id, role, (bool)e.Value!))" />
                                <label class="form-check-label">@role</label>
                            </div>
                        }
                    }

                    <hr />
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAccount(selectedCustomer!.Id)">
                        Delete Account
                    </button>
                    
                    <h6 class="mt-3">Order History</h6>
                    @if (!selectedCustomer.Orders.Any())
                    {
                        <p class="text-secondary small">No orders yet.</p>
                    }
                    else
                    {
                        <table class="table table-sm">
                            <thead><tr><th>Order #</th><th>Status</th><th>Total</th></tr></thead>
                            <tbody>
                                @foreach (var order in selectedCustomer.Orders)
                                {
                                    <tr><td>@order.OrderNumber</td><td>@order.Status</td><td>@AYIGroupMarket.Admin.Services.CurrencyFormatter.Format(order.Total)</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                    
                </div>

            </div>
        </div>
    </div>
}

@code {
    private List<AYIGroupMarket.Application.DTOs.AdminCustomerListItemDto>? customers;
    private AYIGroupMarket.Application.DTOs.AdminCustomerDetailDto? selectedCustomer;
    private string searchTerm = "";
    private List<string>? allRoles;
    private List<string>? userRoles;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    private string? currentAdminUserId;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            currentAdminUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            await Load();
            StateHasChanged();
        }
    }

    private async Task Load()
    {
        customers = await Sender.Send(new GetCustomersQuery(string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm));
    }

    private async Task OnSearch(KeyboardEventArgs e) => await Load();

    private async Task ViewDetail(string userId)
    {
        selectedCustomer = await Sender.Send(new GetCustomerDetailQuery(userId));
        allRoles = await Sender.Send(new GetAllRolesQuery());
        userRoles = await Sender.Send(new GetUserRolesQuery(userId));
    }

    private string WholesaleBadgeClass(string? status) => status switch
    {
        "Approved" => "bg-success",
        "Rejected" => "bg-danger",
        "Suspended" => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private async Task ToggleRole(string userId, string role, bool grant)
    {
        if (userId == currentAdminUserId && role == "Admin" && !grant)
        {
            return;
        }
        await Sender.Send(new SetUserRoleCommand(userId, role, grant));
        userRoles = await Sender.Send(new GetUserRolesQuery(userId));
    }

    private async Task DeleteAccount(string userId)
    {
        if (userId == currentAdminUserId) return;
        await Sender.Send(new DeleteUserCommand(userId));
        selectedCustomer = null;
        await Load();
    }

}