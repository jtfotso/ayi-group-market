@page "/products"
@attribute [Authorize(Policy = "RequireAdmin")]
@inject ISender Sender
@using AYIGroupMarket.Application.Features.Products.GetProducts
@using AYIGroupMarket.Application.Features.Products.CreateProduct
@using AYIGroupMarket.Application.Features.Products.UpdateProduct
@using AYIGroupMarket.Application.Features.Products.DeleteProduct
@using AYIGroupMarket.Application.Features.Categories.GetCategories
@using AYIGroupMarket.Application.DTOs
@using MediatR

<PageTitle>Admin — Products</PageTitle>

<div class="container py-4">
    <h1>Products</h1>

    <table class="table table-sm">
        <thead>
            <tr><th>SKU</th><th>Name</th><th>Category</th><th>Retail Price</th><th>Stock</th><th>Active</th><th></th></tr>
        </thead>
        <tbody>
            @if (products is not null)
            {
                @foreach (var p in products.Items)
                {
                    <tr>
                        <td>@p.Sku</td>
                        <td>@p.Name</td>
                        <td>@p.CategoryName</td>
                        <td>@p.RetailPrice.ToString("C")</td>
                        <td>-</td>
                        <td>-</td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(p.Id)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(p.Id)">Delete</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <h2>@(editingId is null ? "New Product" : "Edit Product")</h2>
    <EditForm Model="@form" OnValidSubmit="Save">
        <div class="row g-2">
            <div class="col-md-3"><input class="form-control" placeholder="SKU" @bind="form.Sku" /></div>
            <div class="col-md-3"><input class="form-control" placeholder="Slug" @bind="form.Slug" /></div>
            <div class="col-md-6">
                <select class="form-select" @bind="form.CategoryId">
                    <option value="">-- Category --</option>
                    @if (categories is not null)
                    {
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-6"><input class="form-control" placeholder="Name FR" @bind="form.Name" /></div>
            <div class="col-md-6"><input class="form-control" placeholder="Name EN" @bind="form.NameEn" /></div>
            <div class="col-md-3"><input type="number" step="0.01" class="form-control" placeholder="Retail Price" @bind="form.RetailPrice" /></div>
            <div class="col-md-3"><input type="number" class="form-control" placeholder="Stock" @bind="form.StockQuantity" /></div>
            <div class="col-md-3 form-check mt-2">
                <input type="checkbox" class="form-check-input" @bind="form.IsActive" />
                <label class="form-check-label">Active</label>
            </div>
            <div class="col-md-3 form-check mt-2">
                <input type="checkbox" class="form-check-input" @bind="form.IsFeatured" />
                <label class="form-check-label">Featured</label>
            </div>
        </div>
        <button class="btn btn-success mt-3" type="submit">Save</button>
    </EditForm>
</div>

@code {
    private PagedResult<ProductListItemDto>? products;
    private List<ProductCategoryDto>? categories;
    private Guid? editingId;
    private ProductFormModel form = new();

    protected override async Task OnInitializedAsync()
    {
        categories = await Sender.Send(new GetCategoriesQuery(IncludeInactive: true));
        await Load();
    }

    private async Task Load()
    {
        products = await Sender.Send(new GetProductsQuery(PageSize: 100));
    }

    private void Edit(Guid id)
    {
        // For a minimal placeholder, full field population on edit is left as a follow-up —
        // would need a GetProductByIdQuery to fetch all editable fields including description/wholesale price
        editingId = id;
    }

    private async Task Save()
    {
        if (editingId is null && Guid.TryParse(form.CategoryId, out var categoryId))
        {
            await Sender.Send(new CreateProductCommand(
                form.Sku, form.Slug, categoryId, form.Name, form.NameEn,
                form.Name, form.NameEn, form.Name, form.NameEn,
                form.RetailPrice, null, null, form.StockQuantity, form.IsActive, form.IsFeatured));
        }

        editingId = null;
        form = new ProductFormModel();
        await Load();
    }

    private async Task Delete(Guid id)
    {
        await Sender.Send(new DeleteProductCommand(id));
        await Load();
    }

    public class ProductFormModel
    {
        public string Sku { get; set; } = "";
        public string Slug { get; set; } = "";
        public string CategoryId { get; set; } = "";
        public string Name { get; set; } = "";
        public string NameEn { get; set; } = "";
        public decimal RetailPrice { get; set; }
        public int StockQuantity { get; set; }
        public bool IsActive { get; set; } = true;
        public bool IsFeatured { get; set; }
    }
}