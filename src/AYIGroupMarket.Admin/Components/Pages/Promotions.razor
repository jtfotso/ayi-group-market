@page "/promotions"
@attribute [Authorize(Policy = "RequireAdmin")]
@inject ISender Sender
@using AYIGroupMarket.Domain.Enums
@using AYIGroupMarket.Domain.Entities
@using Microsoft.EntityFrameworkCore
@using AYIGroupMarket.Infrastructure.Persistence

<PageTitle>Admin — Promotions</PageTitle>

<div class="container py-4">
    <h1>Promotions</h1>

    <table class="table">
        <thead><tr><th>Code</th><th>Type</th><th>Discount</th><th>Min. Order</th><th>Active</th><th>Uses</th><th>Dates</th></tr></thead>
        <tbody>
            @if (promotions is not null)
            {
                @foreach (var p in promotions)
                {
                    <tr>
                        <td>@p.Code</td>
                        <td>@p.Type</td>
                        <td>@(p.DiscountPercentage.HasValue ? $"{p.DiscountPercentage}%" : p.DiscountAmount?.ToString("C") ?? "-")</td>
                        <td>@(p.MinimumOrderAmount?.ToString("C") ?? "-")</td>
                        <td>@(p.IsActive ? "Yes" : "No")</td>
                        <td>@p.UsesCount@(p.MaxUses is not null ? $" / {p.MaxUses}" : "")</td>
                        <td>@p.StartDate.ToString("dd/MM/yy") - @p.EndDate.ToString("dd/MM/yy")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
    @if (createError is not null)
    {
        <div class="alert alert-danger">@createError</div>
    }
    <div class="card p-4 mt-3">
        <h2 class="h5">New Promotion</h2>
        <div class="row g-2">
            <div class="col-md-3"><input class="form-control" placeholder="Code" @bind="code" /></div>
            <div class="col-md-3">
                <select class="form-select" @bind="type">
                    @foreach (var t in Enum.GetValues<PromotionType>())
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-3"><input type="number" step="0.01" class="form-control" placeholder="Discount % or amount" @bind="discountValue" /></div>
            <div class="col-md-3"><input type="number" step="0.01" class="form-control" placeholder="Min. order amount" @bind="minOrderAmount" /></div>
            <div class="col-md-3"><input type="date" class="form-control" @bind="startDate" /></div>
            <div class="col-md-3"><input type="date" class="form-control" @bind="endDate" /></div>
            <div class="col-md-3">
                <select class="form-select" @bind="customerType">
                    @foreach (var ct in Enum.GetValues<PromotionCustomerType>())
                    {
                        <option value="@ct">@ct</option>
                    }
                </select>
            </div>
            <div class="col-md-3"><input type="number" class="form-control" placeholder="Max uses (optional)" @bind="maxUses" /></div>
        </div>
        <button class="btn btn-success mt-3" style="width:fit-content;" @onclick="Create">Create Promotion</button>
    </div>
</div>

@code {
    private List<Promotion>? promotions;
    private string code = "";
    private PromotionType type = PromotionType.PercentageDiscount;
    private decimal discountValue;
    private decimal? minOrderAmount;
    private DateTime startDate = DateTime.Today;
    private DateTime endDate = DateTime.Today.AddMonths(1);
    private PromotionCustomerType customerType = PromotionCustomerType.All;
    private int? maxUses;
    private string? createError;

    [Inject] private AppDbContext Db { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Load();
            StateHasChanged();
        }
    }

    private async Task Load()
    {
        promotions = await Db.Promotions.OrderByDescending(p => p.CreatedAt).ToListAsync();
    }

    private async Task Create()
    {
        createError = null;

        if (string.IsNullOrWhiteSpace(code))
        {
            createError = "Code is required.";
            return;
        }

        var promo = new Promotion
        {
            Code = code.ToUpper(),
            Type = type,
            DiscountPercentage = type == PromotionType.PercentageDiscount ? discountValue : null,
            DiscountAmount = type is PromotionType.FixedAmount or PromotionType.CartDiscount ? discountValue : null,
            MinimumOrderAmount = minOrderAmount,
            StartDate = startDate,
            EndDate = endDate,
            CustomerType = customerType,
            MaxUses = maxUses,
            IsActive = true
        };

        try
        {
            Db.Promotions.Add(promo);
            await Db.SaveChangesAsync();

            code = ""; discountValue = 0; minOrderAmount = null; maxUses = null;
            await Load();
        }
        catch (Exception ex)
        {
            createError = $"Could not save: {ex.Message}"; // likely the unique Code constraint if a duplicate is entered
        }
    }
}