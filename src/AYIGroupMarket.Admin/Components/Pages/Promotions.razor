@page "/promotions"
@attribute [Authorize(Policy = "RequireAdmin")]
@inject ISender Sender
@using AYIGroupMarket.Domain.Enums
@using AYIGroupMarket.Domain.Entities
@using Microsoft.EntityFrameworkCore
@using AYIGroupMarket.Infrastructure.Persistence

<PageTitle>Admin — Promotions</PageTitle>

<div class="container py-4">
    <h1>Promotions</h1>

    <table class="table">
        <thead><tr><th>Code</th><th>Type</th><th>Discount</th><th>Min. Order</th><th>Reserved For</th><th>Active</th><th>Uses</th><th>Dates</th><th></th></tr></thead>
        <tbody>
            @if (promotions is not null)
            {
                @foreach (var p in promotions)
                {
                    <tr>
                        <td>@p.Code</td>
                        <td>@p.Type</td>
                        <td>@(p.DiscountPercentage.HasValue ? $"{p.DiscountPercentage}%" : p.DiscountAmount is not null ? AYIGroupMarket.Admin.Services.CurrencyFormatter.Format(p.DiscountAmount.Value) : "-")</td>
                        <td>@(p.MinimumOrderAmount is not null ? AYIGroupMarket.Admin.Services.CurrencyFormatter.Format(p.MinimumOrderAmount.Value) : "-")</td>
                        <td>@(!string.IsNullOrEmpty(p.TargetCustomerPhone) || !string.IsNullOrEmpty(p.TargetCustomerEmail) ? $"{p.TargetCustomerPhone} {p.TargetCustomerEmail}".Trim() : "Anyone")</td>
                        <td>@(p.IsActive ? "Yes" : "No")</td>
                        <td>@p.UsesCount@(p.MaxUses is not null ? $" / {p.MaxUses}" : "")</td>
                        <td>@p.StartDate.ToString("dd/MM/yy") - @p.EndDate.ToString("dd/MM/yy")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditPromotion(p)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePromotion(p.Id)">Delete</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    @if (createError is not null)
    {
        <div class="alert alert-danger">@createError</div>
    }
    <div class="card p-4 mt-3">
        <h2 class="h5">@(editingId is null ? "New Promotion" : "Edit Promotion")</h2>
        <div class="row g-2">
            <div class="col-md-3"><input class="form-control" placeholder="Code" @bind="code" /></div>
            <div class="col-md-3">
                <select class="form-select" @bind="type">
                    <option value="@PromotionType.PercentageDiscount">PercentageDiscount</option>
                    <option value="@PromotionType.FixedAmount">FixedAmount</option>
                    <option value="@PromotionType.CartDiscount">CartDiscount</option>
                    <option value="@PromotionType.WholesalePromotion">WholesalePromotion</option>
                </select>
            </div>
            <div class="col-md-3"><input type="number" step="0.01" class="form-control" placeholder="Discount % or amount" @bind="discountValue" /></div>
            <div class="col-md-3"><input type="number" step="0.01" class="form-control" placeholder="Min. order amount" @bind="minOrderAmount" /></div>
            <div class="col-md-3"><input type="date" class="form-control" @bind="startDate" /></div>
            <div class="col-md-3"><input type="date" class="form-control" @bind="endDate" /></div>
            <div class="col-md-3">
                <select class="form-select" @bind="customerType">
                    @foreach (var ct in Enum.GetValues<PromotionCustomerType>())
                    {
                        <option value="@ct">@ct</option>
                    }
                </select>
            </div>
            <div class="col-md-3"><input type="number" class="form-control" placeholder="Max uses (optional)" @bind="maxUses" /></div>
            <div class="col-md-6">
                <label class="form-label small">Reserved for phone (optional)</label>
                <input class="form-control" placeholder="e.g. 677000000" @bind="targetPhone" />
            </div>
            <div class="col-md-6">
                <label class="form-label small">Reserved for email (optional)</label>
                <input class="form-control" placeholder="customer@example.com" @bind="targetEmail" />
            </div>
        </div>
        @if (createError is not null)
        {
            <div class="alert alert-danger mt-2">@createError</div>
        }
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-success" style="width:fit-content;" @onclick="Save">
                @(editingId is null ? "Create Promotion" : "Update Promotion")
            </button>
            @if (editingId is not null)
            {
                <button class="btn btn-outline-secondary" style="width:fit-content;" @onclick="CancelEdit">Cancel</button>
            }
        </div>
    </div>
    
</div>

@code {
    private List<Promotion>? promotions;
    private string code = "";
    private PromotionType type = PromotionType.PercentageDiscount;
    private decimal discountValue;
    private decimal? minOrderAmount;
    private DateTime startDate = DateTime.Today;
    private DateTime endDate = DateTime.Today.AddMonths(1);
    private PromotionCustomerType customerType = PromotionCustomerType.All;
    private int? maxUses;
    private string? createError;
    private Guid? editingId;
    private string targetPhone = "";
    private string targetEmail = "";
    [Inject] private AppDbContext Db { get; set; } = null!;


    private void EditPromotion(Promotion p)
    {
        editingId = p.Id;
        code = p.Code;
        type = p.Type;
        discountValue = p.DiscountPercentage ?? p.DiscountAmount ?? 0;
        minOrderAmount = p.MinimumOrderAmount;
        startDate = p.StartDate;
        endDate = p.EndDate;
        customerType = p.CustomerType;
        maxUses = p.MaxUses;
        targetPhone = p.TargetCustomerPhone ?? "";
        targetEmail = p.TargetCustomerEmail ?? "";
    }
    private void CancelEdit()
    {
        editingId = null;
        code = ""; discountValue = 0; minOrderAmount = null; maxUses = null;
        type = PromotionType.PercentageDiscount;
        customerType = PromotionCustomerType.All;
        startDate = DateTime.Today;
        endDate = DateTime.Today.AddMonths(1);
        targetPhone = ""; targetEmail = "";
        createError = null;
    }

    private async Task Save()
    {
        createError = null;

        if (string.IsNullOrWhiteSpace(code))
        {
            createError = "Code is required.";
            return;
        }

        try
        {
            if (editingId is null)
            {
                var promo = new Promotion
                {
                    Code = code.ToUpper(),
                    Type = type,
                    DiscountPercentage = type == PromotionType.PercentageDiscount ? discountValue : null,
                    DiscountAmount = type is PromotionType.FixedAmount or PromotionType.CartDiscount ? discountValue : null,
                    MinimumOrderAmount = minOrderAmount,
                    StartDate = startDate,
                    EndDate = endDate,
                    CustomerType = customerType,
                    MaxUses = maxUses,
                    TargetCustomerPhone = string.IsNullOrWhiteSpace(targetPhone) ? null : targetPhone,
                    TargetCustomerEmail = string.IsNullOrWhiteSpace(targetEmail) ? null : targetEmail,
                    IsActive = true
                };
                Db.Promotions.Add(promo);
            }
            else
            {
                var promo = await Db.Promotions.FirstAsync(p => p.Id == editingId.Value);
                promo.Code = code.ToUpper();
                promo.Type = type;
                promo.DiscountPercentage = type == PromotionType.PercentageDiscount ? discountValue : null;
                promo.DiscountAmount = type is PromotionType.FixedAmount or PromotionType.CartDiscount ? discountValue : null;
                promo.MinimumOrderAmount = minOrderAmount;
                promo.StartDate = startDate;
                promo.EndDate = endDate;
                promo.CustomerType = customerType;
                promo.MaxUses = maxUses;
                promo.TargetCustomerPhone = string.IsNullOrWhiteSpace(targetPhone) ? null : targetPhone;
                promo.TargetCustomerEmail = string.IsNullOrWhiteSpace(targetEmail) ? null : targetEmail;
            }

            await Db.SaveChangesAsync();
            CancelEdit();
            await Load();
        }
        catch (Exception ex)
        {
            createError = $"Could not save: {ex.Message}";
        }
    }

    private async Task DeletePromotion(Guid id)
    {
        var promo = await Db.Promotions.FirstAsync(p => p.Id == id);
        Db.Promotions.Remove(promo);
        await Db.SaveChangesAsync();
        await Load();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Load();
            StateHasChanged();
        }
    }

    private async Task Load()
    {
        promotions = await Db.Promotions.OrderByDescending(p => p.CreatedAt).ToListAsync();
    }
}