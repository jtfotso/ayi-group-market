@page "/orders"
@attribute [Authorize(Policy = "RequireAdmin")]
@inject ISender Sender
@using AYIGroupMarket.Application.Features.Admin.GetOrders
@using AYIGroupMarket.Application.Features.Admin.GetOrderDetail
@using AYIGroupMarket.Application.Features.Admin.UpdateOrderStatus
@using AYIGroupMarket.Application.Features.Admin.CancelOrder
@using AYIGroupMarket.Domain.Enums

<PageTitle>Admin — Orders</PageTitle>

<div class="container py-4">
    <h1>Orders</h1>

    <div class="row g-2 mb-3">
        <div class="col-md-4">
            <input class="form-control" placeholder="Search by order #, name, phone" @bind="searchTerm" @bind:event="oninput" @onkeyup="OnSearch" />
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="statusFilter" @bind:after="OnStatusFilterChanged">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<OrderStatus>())
                {
                    <option value="@status">@status</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-0">Export from</label>
            <input type="date" class="form-control" @bind="exportStartDate" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-0">Export to</label>
            <input type="date" class="form-control" @bind="exportEndDate" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <a href="@ExportUrl" class="btn btn-outline-success w-100" target="_blank">
                <i class="bi bi-download"></i> Export CSV
            </a>
        </div>
    </div>

    <table class="table">
        <thead>
            <tr><th>Order #</th><th>Customer</th><th>Phone</th><th>Status</th><th>Total</th><th>Payment</th><th>Date</th><th></th></tr>
        </thead>
        <tbody>
            @if (orders is not null)
            {
                @foreach (var o in orders.Items)
                {
                    <tr>
                        <td>@o.OrderNumber</td>
                        <td>@o.CustomerName</td>
                        <td>@o.CustomerPhone</td>
                        <td><span class="badge @StatusBadgeClass(o.Status)">@o.Status</span></td>
                        <td>@o.Total.ToString("C")</td>
                        <td>@o.PaymentMethod</td>
                        <td>@o.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td><button class="btn btn-sm btn-outline-primary" @onclick="() => OpenDetail(o.Id)">View</button></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (selectedOrder is not null)
{
    <div class="modal d-block" style="background:rgba(0,0,0,.5);" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Order @selectedOrder.OrderNumber</h5>
                    <button class="btn-close" @onclick="() => selectedOrder = null"></button>
                </div>
                <div class="modal-body">
                    @if (selectedOrder.CustomerConfirmedAt is not null)
                    {
                        <p class="text-success"><i class="bi bi-check-circle-fill"></i> Customer confirmed receipt on @selectedOrder.CustomerConfirmedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                    }
                    @if (actionError is not null)
                    {
                        <div class="alert alert-danger">@actionError</div>
                    }
                    <p><strong>Customer:</strong> @selectedOrder.CustomerName — @selectedOrder.CustomerPhone @(selectedOrder.CustomerEmail is not null ? $"— {selectedOrder.CustomerEmail}" : "")</p>
                    @if (selectedOrder.IsPickup)
                    {
                        <p><strong>Delivery:</strong> Store pickup</p>
                    }
                    else
                    {
                        <p><strong>Delivery:</strong> @selectedOrder.AddressLine, @selectedOrder.City (@selectedOrder.ShippingZoneName)</p>
                    }
                    <p><strong>Payment method:</strong> @selectedOrder.PaymentMethod</p>

                    <table class="table table-sm">
                        <thead><tr><th>Item</th><th>Qty</th><th>unit price</th><th>Total</th></tr></thead>
                        <tbody>
                            @foreach (var item in selectedOrder.Items)
                            {
                                <tr><td>@item.ProductName</td><td>@item.Quantity</td><td>@item.UnitPrice.ToString("C")</td><td>@item.LineTotal.ToString("C")</td></tr>
                            }
                        </tbody>
                    </table>
                    <p class="fw-bold">Total: @selectedOrder.Total.ToString("C")</p>

                    <div class="row g-2 mt-3">
                        <div class="col-md-6">
                            <label class="form-label">Status</label>
                            <select class="form-select" @bind="newStatus">
                                @foreach (var status in Enum.GetValues<OrderStatus>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tracking number</label>
                            <input class="form-control" @bind="trackingNumber" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    @if (selectedOrder.Status is "Paid" or "Processing" or "ReadyForDelivery" or "Shipped" or "Delivered")
                    {
                        <a href="/orders/@selectedOrder.Id/invoice.pdf" class="btn btn-outline-success" target="_blank">
                            <i class="bi bi-file-earmark-pdf"></i> Download Invoice
                        </a>
                    }
                    <button class="btn btn-outline-danger" @onclick="() => CancelSelectedOrder()">Cancel Order</button>
                    <button class="btn btn-success" @onclick="SaveStatus">Save</button>
                </div>
            </div>
        </div>
    </div>
}



@code {
    private PagedResult<AYIGroupMarket.Application.DTOs.AdminOrderListItemDto>? orders;
        [SupplyParameterFromQuery(Name = "status")] public string? InitialStatusFilter { get; set; }
    private string searchTerm = "";
    private string statusFilter = "";
    private AYIGroupMarket.Application.DTOs.AdminOrderDetailDto? selectedOrder;
    private OrderStatus newStatus;
    private string? actionError;
    private string trackingNumber = "";
    private DateTime exportStartDate = DateTime.Today.AddMonths(-1);
    private DateTime exportEndDate = DateTime.Today;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!string.IsNullOrEmpty(InitialStatusFilter))
                statusFilter = InitialStatusFilter;

            await Load();
            StateHasChanged();
        }
    }

    private async Task Load()
    {
        OrderStatus? status = string.IsNullOrEmpty(statusFilter) ? null : Enum.Parse<OrderStatus>(statusFilter);
        orders = await Sender.Send(new GetOrdersQuery(status, string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm));
    }

    private async Task OnStatusFilterChanged() => await Load();
    private async Task OnSearch(KeyboardEventArgs e) => await Load();

    private async Task OpenDetail(Guid orderId)
    {
        selectedOrder = await Sender.Send(new GetOrderDetailQuery(orderId));
        if (selectedOrder is not null)
        {
            newStatus = Enum.Parse<OrderStatus>(selectedOrder.Status);
            trackingNumber = selectedOrder.TrackingNumber ?? "";
        }
    }

    private async Task SaveStatus()
    {
        if (selectedOrder is null) return;
        actionError = null;

        try
        {
            await Sender.Send(new UpdateOrderStatusCommand(selectedOrder.Id, newStatus, string.IsNullOrWhiteSpace(trackingNumber) ? null : trackingNumber));
            selectedOrder = null;
            await Load();
        }
        catch (FluentValidation.ValidationException ex)
        {
            actionError = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
    }

    private async Task CancelSelectedOrder()
    {
        if (selectedOrder is null) return;
        actionError = null;

        try
        {
            await Sender.Send(new CancelOrderCommand(selectedOrder.Id, "Cancelled by admin"));
            selectedOrder = null;
            await Load();
        }
        catch (FluentValidation.ValidationException ex)
        {
            actionError = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
    }

    private string StatusBadgeClass(string status) => status switch
    {
        "Pending" => "bg-secondary",
        "PaymentPending" => "bg-warning text-dark",
        "Paid" => "bg-success",
        "Processing" => "bg-info text-dark",
        "ReadyForDelivery" => "bg-primary",
        "Shipped" => "bg-primary",
        "Delivered" => "bg-success",
        "Cancelled" => "bg-danger",
        "Refunded" => "bg-dark",
        _ => "bg-secondary"
    };
    private string ExportUrl =>
        $"/orders/export.csv?start={exportStartDate:yyyy-MM-dd}&end={exportEndDate:yyyy-MM-dd}";
}