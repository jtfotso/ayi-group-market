@page "/account/register"
@using System.Globalization

<PageTitle>@(IsFr ? "Créer un compte" : "Register") — AYI GROUP MARKET</PageTitle>

<div class="container py-5" style="max-width: 480px;">
    <h1 class="fw-bold mb-4">@(IsFr ? "Créer un compte" : "Create an account")</h1>

    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger">@Error</div>
    }

    <form method="post" action="/account/register-submit">
        <div class="mb-3">
            <label class="form-label">@(IsFr ? "Prénom" : "First name")</label>
            <input class="form-control" name="firstName" required />
        </div>
        <div class="mb-3">
            <label class="form-label">@(IsFr ? "Nom" : "Last name")</label>
            <input class="form-control" name="lastName" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" name="email" required />
        </div>
        <div class="mb-3">
            <label class="form-label">@(IsFr ? "Mot de passe" : "Password")</label>
            <input type="password" class="form-control" name="password" required />
        </div>
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />

        <button class="btn btn-success w-100" type="submit">@(IsFr ? "Créer mon compte" : "Create account")</button>
    </form>

    <p class="mt-3 text-center small">
        @(IsFr ? "Déjà un compte ?" : "Already have an account?")
        <a href="/account/login">@(IsFr ? "Se connecter" : "Log in")</a>
    </p>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }

    private bool IsFr => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fr";
}